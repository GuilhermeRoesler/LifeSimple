# URL pública do site (sem barra final) — usada em OG, canonical e sitemap
VITE_SITE_URL="https://lifesimple.example.com"

# Google Gemini — SOMENTE no servidor (nunca com prefixo VITE_)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Firebase configuration (cliente)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_APP_ID"

# Opcional no servidor: sobrescreve o projectId usado na validação do ID token.
# Se omitido, o proxy usa VITE_FIREBASE_PROJECT_ID.
# FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"

# Em produção atrás de reverse proxy (nginx, Cloudflare, etc.), ative para
# confiar em X-Forwarded-For no rate limit por IP.
# TRUST_PROXY=true
